#################################################
# 🔧 SERVER CONFIGURATION
#################################################
PORT=5000
NODE_ENV=development

#################################################
# 🗄️ DATABASE CONFIGURATION
# DB_TYPE: choose between "mongodb" or "mysql"
#################################################
DB_TYPE=mongodb

# --- MongoDB ---
MONGO_URI=

# --- MySQL ---
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

#################################################
# 🔐 AUTHENTICATION CONFIGURATION
# AUTH_TYPE: choose between "jwt" or "cognito"
#################################################
AUTH_TYPE=cognito

# --- JWT ---
JWT_SECRET=

# --- AWS Cognito ---
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

#################################################
# ☁️ CLOUDINARY (for image uploads)
#################################################
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=